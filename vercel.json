{
  "outputDirectory": ".",
  "builds": [],
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/airbnb-specialist", "destination": "/airbnb-cleaning", "permanent": true },
    { "source": "/airbnb-specialist.html", "destination": "/airbnb-cleaning", "permanent": true },
    { "source": "/videos", "destination": "/how-it-works", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(img|fonts|brand|video)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
